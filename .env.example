# =============================================================================
# Fechi Organics — Environment Variables
# Copy this file to .env.local and fill in every value before running the app.
# NEVER commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/fechi_organics"

# -----------------------------------------------------------------------------
# Better Auth
# -----------------------------------------------------------------------------
# A long, random secret used to sign session tokens.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The canonical URL of your application (no trailing slash).
BETTER_AUTH_URL="http://localhost:3000"

# Public-facing app URL (exposed to the browser via NEXT_PUBLIC_ prefix).
# Must match BETTER_AUTH_URL in most deployments.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Where the site-wide WhatsApp button lives: "navbar" (default — an icon in
# Navbar.tsx/Home-Navbar.tsx, desktop + mobile) or "floating" (the old fixed
# bottom-right bubble, WhatsAppButton.tsx). Does not affect the product page
# or /contact, which already embed their own WhatsApp CTA.
NEXT_PUBLIC_WHATSAPP_BUTTON_POSITION="navbar"

# -----------------------------------------------------------------------------
# Google OAuth
# -----------------------------------------------------------------------------
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# -----------------------------------------------------------------------------
# Facebook OAuth
# -----------------------------------------------------------------------------
# Create an app at: https://developers.facebook.com/apps/
# Valid OAuth Redirect URI: http://localhost:3000/api/auth/callback/facebook
FACEBOOK_CLIENT_ID="your-facebook-app-id"
FACEBOOK_CLIENT_SECRET="your-facebook-app-secret"

# -----------------------------------------------------------------------------
# Cookie Consent
# -----------------------------------------------------------------------------
# "true" treats every visitor as already consented — the banner never shows
# and Google Analytics loads immediately. Dev convenience only; leave
# unset/"false" in production.
COOKIE_CONSENT_DEV_BYPASS=false

# -----------------------------------------------------------------------------
# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
# -----------------------------------------------------------------------------
# Bot protection on the login/signup/admin-login forms.
# For local dev, use Cloudflare's always-pass test keys instead of real ones:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# -----------------------------------------------------------------------------
# Email — Resend (https://resend.com)
# -----------------------------------------------------------------------------
# Get your API key at: https://resend.com/api-keys
# Used to send OTP verification codes and transactional emails.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Cloudflare R2 object storage
# -----------------------------------------------------------------------------
# R2_ACCOUNT_ID must be the bare 32-char hex account ID (not a full URL).
# Find it at: Cloudflare Dashboard → R2 → Overview → Account ID
# R2 public base URL — the browser-accessible root for all uploaded objects.
# Use the bucket's public R2 URL: https://<account-id>.r2.dev
# or a custom domain you've configured in Cloudflare (e.g. https://cdn.yourdomain.com).
# Must NOT have a trailing slash. Leave blank to fall back to relative paths in dev.
NEXT_PUBLIC_R2_PUBLIC_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# -----------------------------------------------------------------------------
# Zoho Inventory
# -----------------------------------------------------------------------------
# Setup: https://api-console.zoho.com → Self-Client
# Scopes: ZohoInventory.items.READ ZohoInventory.salesorders.CREATE
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Branch Credential Encryption (AES-256-GCM)
# -----------------------------------------------------------------------------
# 64-character hex string (32 bytes). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BRANCH_SECRET_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# M-Pesa / Daraja
# -----------------------------------------------------------------------------
# Must be your real public HTTPS origin — Safaricom/KCB POST results here.
MPESA_CALLBACK_BASE_URL=
# "sandbox" or "production". MUST be exactly "production" on a live deploy —
# lib/payments/mpesa/stk-push.ts only switches to api.safaricom.co.ke on an
# exact match; anything else (including a typo) silently targets
# sandbox.safaricom.co.ke, which accepts any request and never rings a real
# handset (the accepted-then-1037-with-no-prompt symptom).
DARAJA_ENV=sandbox
# Daraja API access isn't live yet — leave unset (or "false") to force every
# M-Pesa payment through KCB Buni regardless of branch.mpesaGateway. Set to
# "true" once Daraja access is ready to restore per-branch dispatch.
DARAJA_ENABLED=false

# -----------------------------------------------------------------------------
# KCB Buni (M-Pesa via KCB) — previously undocumented; required in production
# -----------------------------------------------------------------------------
# Buni API host. MUST be the production host on a live deploy — there is no
# built-in default, and lib/payments/kcb/kcb-client.ts refuses to guess a
# sandbox one. Using https://uat.buni.kcbgroup.com in production is the same
# accepted-then-1037-with-no-prompt failure as a wrong DARAJA_ENV above.
KCB_BASE_URL=
# Falls back to MPESA_CALLBACK_BASE_URL if unset — set explicitly if KCB's
# callback should land on a different path/host than Daraja's.
KCB_CALLBACK_BASE_URL=
# Per-branch credentials normally live encrypted in the branch table
# (consumerKeyEnc/consumerSecretEnc/apiKeyEnc/shortcode — see
# prisma/set-daraja-creds.example.ts). These four are fallbacks only, read by
# app/api/payments/kcb/initiate/route.ts when a branch row has no value of
# its own — leave unset unless you specifically need that fallback.
KCB_CONSUMER_KEY=
KCB_CONSUMER_SECRET=
KCB_API_KEY=
KCB_SHORTCODE=

# -----------------------------------------------------------------------------
# PayHero
# -----------------------------------------------------------------------------
PAYHERO_USERNAME=
PAYHERO_PASSWORD=
PAYHERO_CHANNEL_ID=

# -----------------------------------------------------------------------------
# Paystack
# -----------------------------------------------------------------------------
# Secret key — server-side only, used to call the Paystack API and verify
# webhook signatures. Get both keys from: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=
# Public key — safe to expose to the browser, used by Paystack Inline.js for
# the admin in-store card payment flow.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# -----------------------------------------------------------------------------
# PostHog Analytics (https://posthog.com)
# -----------------------------------------------------------------------------
# Get your project API key from: PostHog → Project Settings → Project API Key
# Use https://eu.i.posthog.com for EU data residency.
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# -----------------------------------------------------------------------------
# Sentry (https://sentry.io) — error tracking, mostly for API/server failures
# -----------------------------------------------------------------------------
# DSNs from: Sentry → Project Settings → Client Keys (DSN). Leave unset to
# disable Sentry entirely (dev works fine without it).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Org/project slug + numeric project id, used both for source map upload at
# build time and to link Sentry issues <-> PostHog session replays.
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_SENTRY_ORG=
NEXT_PUBLIC_SENTRY_PROJECT_ID=
# Auth token for uploading source maps during build: Sentry → Settings →
# Auth Tokens (needs project:releases scope). Only needed in CI/production builds.
SENTRY_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# Twilio (SMS / WhatsApp)
# -----------------------------------------------------------------------------
# Get credentials at: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# -----------------------------------------------------------------------------
# Africa's Talking (SMS — Kenya)
# -----------------------------------------------------------------------------
# Get credentials at: https://account.africastalking.com
# Use username "sandbox" for testing without a live account.
# Kenyan numbers (+254) are routed through Africa's Talking; every other
# country falls back to Twilio above. See lib/sms.ts.
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_SENDER_ID=

# -----------------------------------------------------------------------------
# Vercel Cron
# -----------------------------------------------------------------------------
# Vercel automatically sends this as `Authorization: Bearer $CRON_SECRET` on
# every scheduled cron request (see vercel.json) — set it so worker routes
# triggered by cron can verify the request actually came from Vercel Cron.
# Generate one with: openssl rand -base64 32
CRON_SECRET=

# -----------------------------------------------------------------------------
# Developer admin access (optional)
# -----------------------------------------------------------------------------
# Lets a developer view /admin/* without a real admin account — no row is
# ever written to user/adminProfile. Leave unset to disable entirely (the
# bypass is a no-op unless this is set). Visit /dev/access?key=<this value>
# to toggle it on/off for your browser. Generate one with: openssl rand -base64 32
DEV_ACCESS_SECRET=

# -----------------------------------------------------------------------------
# Loyalty points (required in production)
# -----------------------------------------------------------------------------
# HMAC key for the append-only points ledger's hash chain. Every entry is signed
# with it, which is what makes tampering with pointsLedger detectable; the key
# lives here and never in the database, so database access alone cannot forge an
# entry. Generate with: openssl rand -hex 32
#
# WITHOUT THIS SET, awardPoints() THROWS in production and no customer ever
# earns a point — the failure is caught by each call site, so it is silent.
# Rotating it invalidates every existing hash and verifyChain() will report the
# whole ledger as broken, so set it once and keep it.
POINTS_LEDGER_SECRET=

# -----------------------------------------------------------------------------
# Background jobs and cache (required — previously undocumented)
# -----------------------------------------------------------------------------
# QStash delivers every background job (order confirmations, invoices, loyalty
# point awards). Without these the jobs are silently skipped.
QSTASH_TOKEN=
QSTASH_URL=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Upstash Redis — payment/session SSE signalling and rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Salt for hashed channel keys and identity signals. Generate with: openssl rand -hex 32
REDIS_CHANNEL_SECRET=
