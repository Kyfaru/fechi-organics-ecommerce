// ============================================================================
// Loyalty — badge catalog, grants, abuse review (admin schema)
// ============================================================================

/// Superseded by the badge/level ladder. Kept only so no DROP has to run
/// through scripts/db-deploy-prod.sh — nothing reads it.
/// ponytail: dead table, cheaper to leave than to migrate away.
model loyaltyTier {
  id         String   @id @default(cuid())
  name       String
  minSpend   Int
  multiplier Float    @default(1.0)
  benefits   String[]
  color      String

  @@schema("admin")
}

/// Generated from lib/points/badge-families.ts by prisma/seed-badges.ts.
/// `id` is a stable slug ("orders.t07") so re-seeding is idempotent and
/// userBadge rows survive a catalog regeneration.
model badge {
  id          String         @id
  familyKey   String
  tier        Int
  name        String
  description String
  icon        String
  rarity      BadgeRarity
  points      Int
  grantType   BadgeGrantType @default(AUTO)
  ruleKey     String?
  threshold   BigInt?
  hidden      Boolean        @default(false)
  sortOrder   Int
  createdAt   DateTime       @default(now())

  @@unique([familyKey, tier])
  @@index([familyKey])
  @@index([grantType])
  @@schema("admin")
}

/// A super admin's request to inject points by hand. Released only when every
/// currently-active super admin has approved. See lib/points/grants.ts.
model pointsGrantRequest {
  id                        String                @id @default(uuid())
  requestedByAdminProfileId String
  requestedBy               adminProfile          @relation(fields: [requestedByAdminProfileId], references: [id])
  targetUserId              String
  points                    Int
  note                      String
  status                    ApprovalStatus        @default(PENDING)
  createdAt                 DateTime              @default(now())
  decidedAt                 DateTime?
  approvals                 pointsGrantApproval[]

  @@index([status])
  @@index([targetUserId])
  @@schema("admin")
}

model pointsGrantApproval {
  id             String             @id @default(uuid())
  requestId      String
  request        pointsGrantRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  adminProfileId String
  adminProfile   adminProfile       @relation(fields: [adminProfileId], references: [id])
  decision       ApprovalStatus
  decidedAt      DateTime           @default(now())

  @@unique([requestId, adminProfileId])
  @@schema("admin")
}

model pointsAbuseFlag {
  id                       String    @id @default(uuid())
  userId                   String
  score                    Int
  reasons                  Json
  action                   String
  reviewedByAdminProfileId String?
  reviewedAt               DateTime?
  createdAt                DateTime  @default(now())

  @@index([userId])
  @@index([reviewedAt])
  @@schema("admin")
}

