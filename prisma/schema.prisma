generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "admin", "client"]
}

// ============================================================================
// Enums
// ============================================================================

enum MpesaGateway {
  DARAJA
  KCB_BUNI

  @@schema("public")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  WAITING_TO_PACKAGE
  READY_FOR_PICKUP
  PICKED_UP
  FAILED

  @@schema("public")
}

enum MessageType {
  ORDER_UPDATE
  SYSTEM
  PROMOTION
  ALERT

  @@schema("public")
}

enum TestimonialSource {
  facebook
  manual

  @@schema("public")
}

enum ContactStatus {
  new
  read
  archived

  @@schema("public")
}

enum UserRole {
  client
  admin

  @@schema("public")
}

enum TxStatus {
  PENDING
  SUCCESS
  FAILED
  TIMEOUT

  @@schema("public")
}

enum PaymentProvider {
  MPESA
  PAYSTACK
  KCB

  @@schema("public")
}

enum MpesaType {
  PAYBILL
  TILL

  @@schema("public")
}

enum DeliveryType {
  PICKUP
  DELIVERY

  @@schema("public")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED

  @@schema("public")
}

enum TicketStatus {
  OPEN
  RESOLVED
  EXPIRED

  @@schema("public")
}

enum MessageSender {
  CUSTOMER
  ADMIN

  @@schema("public")
}

enum CampaignType {
  EMAIL
  SMS
  PUSH
  WHATSAPP
  ALL

  @@schema("admin")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED

  @@schema("admin")
}

enum PostStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED

  @@schema("admin")
}

enum POStatus {
  DRAFT
  SENT
  CONFIRMED
  RECEIVED
  CANCELLED

  @@schema("admin")
}

enum InStoreFulfillmentStatus {
  CONFIRMED
  PICKED_UP

  @@schema("admin")
}

enum InStoreProvider {
  MPESA_STK
  MPESA_C2B
  PAYSTACK

  @@schema("admin")
}

enum NotificationSeverity {
  CRITICAL
  WARNING
  INFO

  @@schema("admin")
}

enum NotificationType {
  ORDER_NEW
  ORDER_FAILED
  ORDER_CANCELLED
  PAYMENT_ERROR
  PRODUCT_ADDED
  PRODUCT_DELETED
  LOW_STOCK
  STAFF_ADDED
  STAFF_REMOVED
  TICKET_NEW
  TICKET_RESPONSE
  CONTACT_INQUIRY
  DELIVERY_ZONE_REQUEST
  ADMIN_ADDED
  SYSTEM_ALERT
  APPROVAL_REQUESTED
  APPROVAL_DECIDED
  EXPORT_READY
  LOYALTY_GRANT_REQUESTED
  LOYALTY_GRANT_RELEASED
  LOYALTY_ABUSE_FLAG
  LOYALTY_LEDGER_BREACH

  @@schema("admin")
}

// ============================================================================
// Auth models — Better Auth managed (public schema)
// ============================================================================

model user {
  id                    String          @id @default(uuid())
  name                  String
  firstName             String?
  lastName              String?
  username              String?         @unique
  phone                 String?
  country               String?
  city                  String?
  companyId             String?
  email                 String          @unique
  emailVerified         Boolean         @default(false)
  image                 String?
  role                  UserRole        @default(client)
  loginCount            Int             @default(0)
  banned                Boolean         @default(false)
  banReason             String?
  banExpires            DateTime?
  twoFactorEnabled      Boolean         @default(false)
  twoFaEmail            Boolean         @default(false)
  twoFaPhone            Boolean         @default(false)
  mustChangePassword    Boolean         @default(false)
  usernameChanges       Int             @default(0)
  lastUsernameChange    DateTime?
  passwordChanges       Int             @default(0)
  lastPasswordChange    DateTime?
  phoneCode             String?
  langPreference        String          @default("en-GB")
  currencyDisplay       String          @default("KES")
  notifBotanicalUpdates Boolean         @default(true)
  notifOrderTracking    Boolean         @default(true)
  notifPersonalized     Boolean         @default(true)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  sessions              session[]
  accounts              account[]
  cart                  cart?
  cookieConsent         cookieConsent?
  favorites             favorite[]
  orders                order[]
  adminProfile          adminProfile?
  clientProfile         clientProfile?
  twoFactors            twoFactor[]
  supportTickets        supportTicket[] @relation("TicketOwner")
  assignedTickets       supportTicket[] @relation("TicketAssignee")
  blogPosts             blogPost[]
  loyaltyPoints         loyaltyPoints?
  pointsLedger          pointsLedger[]
  badges                userBadge[]
  inboxMessages         inboxMessage[]
  wishlistItems         wishlistItem[]
  blogReactions         blogReaction[]
  blogComments          blogComment[]

  @@index([role])
  @@schema("public")
}

model session {
  id                String    @id
  userId            String
  token             String    @unique
  expiresAt         DateTime
  ipAddress         String?
  userAgent         String?
  captchaVerifiedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@schema("public")
}

model twoFactor {
  id          String  @id
  secret      String
  backupCodes String
  verified    Boolean @default(false)
  userId      String
  user        user    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

// ============================================================================
// Storefront models (public schema)
// ============================================================================

model category {
  id        String    @id @default(uuid())
  key       String    @unique
  name      String
  slug      String    @unique
  imageKey  String
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  products  product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isActive, sortOrder])
  @@schema("public")
}

model product {
  id                  String               @id @default(uuid())
  name                String
  slug                String               @unique
  /// Nullable because it's Zoho-sourced — a sync with no description for this
  /// item nulls it out rather than leaving stale/default text (see zoho-sync.ts).
  description         String?
  shortDescription    String?
  categoryId          String
  category            category             @relation(fields: [categoryId], references: [id])
  priceKes            Int
  compareAtPriceKes   Int?
  variantLabel        String?
  sizes               String[]             @default([])
  /// "sizes" (default, uses `sizes` above) or "variants" (uses the
  /// `variants` relation below) — controls which selector the admin edit
  /// form and storefront product page render. Two independent mechanisms
  /// kept deliberately separate rather than merged, since sizes are plain
  /// strings with no photo, and variants are always photo-backed.
  variantMode         String               @default("sizes")
  /// Heading shown above the variant options on the storefront, e.g. "Color".
  variantGroupLabel   String?
  /// Amazon-style toggle: when true, images tied to a variant are hidden
  /// from the storefront gallery until that variant is clicked; when false
  /// (default) every image — variant-linked or not — always shows.
  variantImagesHidden Boolean              @default(false)
  variants            productVariant[]
  howToUse            String?
  ingredients         String?
  bestSeller          Boolean              @default(false)
  isActive            Boolean              @default(true)
  /// DEPRECATED — superseded by branchProductStock (stock is now per-branch).
  /// No longer read by checkout or admin inventory; the public storefront
  /// never gates on stock at all. Left in place for historic data only.
  stock               Int                  @default(0)
  /// Manual admin override — the storefront's only stock gate. Independent
  /// of the deprecated `stock` field and per-branch Zoho stock.
  outOfStock          Boolean              @default(false)
  ratingAvg           Float                @default(0)
  ratingCount         Int                  @default(0)
  // Zoho catalog fields — populated (or nulled, if absent from Zoho) on every
  // sync. Which Zoho item this maps to per organization now lives in
  // productZohoMapping (each of the two orgs assigns its own opaque item id
  // to "the same" product), not a column here.
  zohoSku             String?
  zohoItemType        String?
  zohoStatus          String?
  zohoUnit            String?
  zohoBrand           String?
  purchaseRateKes     Int?
  /// Raw Zoho category_name text, kept even when it doesn't match one of our
  /// active categories, so the gap is visible for manual reconciliation
  /// instead of silently disappearing (categoryId itself is left untouched).
  zohoCategoryNameRaw String?
  lastZohoSyncedAt    DateTime?
  images              productImage[]
  cartItems           cartItem[]
  favorites           favorite[]
  orderItems          orderItem[]
  branchStocks        branchProductStock[]
  zohoMappings        productZohoMapping[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([categoryId, isActive])
  @@index([isActive, bestSeller])
  @@index([isActive, createdAt])
  @@index([isActive, priceKes])
  @@schema("public")
}

model productImage {
  id        String           @id @default(uuid())
  productId String
  product   product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  objectKey String
  alt       String           @default("")
  sortOrder Int              @default(0)
  isPrimary Boolean          @default(false)
  createdAt DateTime         @default(now())
  variants  productVariant[]

  @@index([productId, sortOrder])
  @@schema("public")
}

// A color/flavour/etc. option for a product in "variants" mode (see
// product.variantMode). Only affects the storefront/orders — never synced
// to or read by the Zoho integration (lib/zoho-sync.ts,
// lib/zoho/push-sale-receipt.ts, lib/zoho/push-adjustment.ts all key off
// productId only, so this is invisible to Zoho by construction).
model productVariant {
  id         String        @id @default(cuid())
  productId  String
  product    product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  label      String
  imageId    String?
  image      productImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)
  sortOrder  Int           @default(0)
  cartItems  cartItem[]
  orderItems orderItem[]
  createdAt  DateTime      @default(now())

  @@index([productId, sortOrder])
  @@schema("public")
}

model cart {
  id        String     @id @default(uuid())
  userId    String?    @unique
  user      user?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String?    @unique
  items     cartItem[]
  // Attribution snapshot at cart creation — the conversion-rate denominator
  // (paid orders ÷ carts) for the Reports social-channel section.
  utmSource String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([updatedAt])
  @@schema("public")
}

model cookieConsent {
  id           String   @id @default(uuid())
  userId       String?  @unique
  user         user?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String?  @unique
  consentToken String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@schema("public")
}

model cartItem {
  id           String          @id @default(uuid())
  cartId       String
  cart         cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId    String
  product      product         @relation(fields: [productId], references: [id])
  /// Selected variant (product.variantMode === "variants") — never touched
  /// by Zoho. SetNull so removing a variant later doesn't break the cart.
  variantId    String?
  variant      productVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantLabel String?
  quantity     Int             @default(1)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  // Includes variantId so the same product can sit in the cart once per
  // variant. Postgres treats NULLs as distinct in unique indexes, so a
  // sizes-mode/no-variant product (variantId always null) could in theory
  // get two rows — the cart API (lib/cart.ts) is responsible for looking up
  // by (cartId, productId, variantId) before inserting rather than relying
  // on this constraint alone to dedupe the null case.
  @@unique([cartId, productId, variantId])
  @@schema("public")
}

model favorite {
  id        String   @id @default(uuid())
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@schema("public")
}

model testimonial {
  id           String            @id @default(uuid())
  authorName   String
  location     String?
  quote        String
  rating       Int               @default(5)
  title        String?
  orderId      String?
  userId       String?
  beforeKey    String?
  afterKey     String?
  source       TestimonialSource @default(manual)
  approved     Boolean           @default(false)
  sortOrder    Int               @default(0)
  productIds   String[]          @default([])
  contactEmail String?
  contactPhone String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([approved, sortOrder])
  @@schema("public")
}

model order {
  id                        String             @id @default(uuid())
  userId                    String?
  user                      user?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestEmail                String?
  status                    OrderStatus        @default(PENDING)
  zohoSoId                  String?            @unique // Zoho Books salesreceipt_id (name kept for historical/migration reasons)
  orderNumber               String?            @unique
  processingBy              String?
  processedAt               DateTime?
  confirmedBy               String?
  confirmedAt               DateTime?
  shippedAt                 DateTime?
  subtotalKes               Int
  deliveryKes               Int                @default(35000)
  discountKes               Int                @default(0)
  // Loyalty points spent on this order, and their cash value in cents.
  // pointsDiscountKes is already subtracted inside totalKes, so revenue
  // (totalKes - deliveryKes) excludes points-funded value automatically.
  pointsRedeemed            Int                @default(0)
  pointsDiscountKes         Int                @default(0)
  totalKes                  Int
  promoCode                 String?
  items                     orderItem[]
  branchId                  String?
  branch                    branch?            @relation(fields: [branchId], references: [id])
  transactions              transaction[]
  deliveryAddress           String?
  deliveryCity              String?
  deliveryCounty            String?
  deliveryZone              String?
  deliveryPhone             String?
  // International orders only — deliveryCity already carries state/province
  // (see app/api/payments/*/initiate routes), these two were previously
  // collected on the checkout form but never persisted.
  deliveryPostalCode        String?
  deliveryCountry           String?
  deliveryType              DeliveryType       @default(DELIVERY)
  isInternational           Boolean            @default(false)
  paymentStatus             PaymentStatus      @default(PENDING)
  receiptSent               Boolean            @default(false)
  pickupCode                String?
  pickupCodeExpiresAt       DateTime?
  pickedUpAt                DateTime?
  customerPickupConfirmedAt DateTime?
  staffPickupConfirmedAt    DateTime?
  reviewedAt                DateTime?
  invoiceNumber             String?            @unique
  invoicePdfKey             String?
  // Idempotency flag for the queued order-cancellation-notify worker (same
  // boolean-flag convention as receiptSent) — set once email/SMS/inbox/admin
  // notification fan-out has run for this order's cancellation.
  cancellationNotifiedAt    DateTime?
  // Last-touch marketing attribution, stamped from the fechi_utm cookie
  // (set by PostHogProvider on landing) — powers the Reports conversion-rate
  // by social channel section. Nullable: most historical orders predate this.
  utmSource                 String?            @db.VarChar(64)
  utmMedium                 String?            @db.VarChar(64)
  utmCampaign               String?            @db.VarChar(128)
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  statusEvents              orderStatusEvent[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([utmSource])
  @@schema("public")
}

model orderItem {
  id           String          @id @default(uuid())
  orderId      String
  order        order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      product         @relation(fields: [productId], references: [id])
  name         String
  priceKes     Int
  quantity     Int
  /// Selected variant, denormalized the same way `name`/`priceKes` already
  /// snapshot the product at order time. SetNull so deleting a variant later
  /// never breaks historical orders. Never sent to Zoho.
  variantId    String?
  variant      productVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantLabel String?

  @@index([orderId])
  @@schema("public")
}

model branch {
  id                   String                @id @default(uuid())
  name                 String
  county               String
  address              String?
  phone                String?
  slug                 String?
  lat                  Float?
  lng                  Float?
  mpesaType            MpesaType
  shortcode            String?
  invoiceNumber        String? // KCB Buni invoice/account number (plaintext)
  consumerKeyEnc       String
  consumerSecretEnc    String
  passkeyEnc           String?
  mpesaGateway         MpesaGateway          @default(DARAJA)
  paystackSubaccount   String?
  cardEligible         Boolean               @default(false)
  apiKeyEnc            String?
  isMain               Boolean               @default(false)
  isActive             Boolean               @default(true)
  // Zoho Books — a branch belongs to one of a small number of shared orgs
  // (credentials live on zohoOrganization; several branches can point at the
  // same org). zohoLocationId is this branch's Zoho Books Location id
  // (Settings → Locations) within that org — tags every Sales Receipt this
  // branch pushes with the correct physical location. Not used for stock
  // splitting (every branch under an org shares the org's aggregate stock —
  // see lib/zoho-sync.ts).
  zohoOrganizationId   String?
  zohoOrganization     zohoOrganization?     @relation(fields: [zohoOrganizationId], references: [id])
  zohoLocationId       String?
  // Zoho Inventory (a separate product from Books) warehouse id for this
  // branch — distinct from zohoLocationId above. Used to tag which warehouse
  // an automatic Inventory Adjustment applies to (see
  // lib/zoho/push-adjustment.ts). Optional — every branch under an org
  // shares the same aggregate deduction target if unset.
  zohoWarehouseId      String?
  orders               order[]
  deliveryZones        DeliveryZone[]
  adminProfiles        adminProfile[]
  transactions         transaction[]
  inStoreOrders        inStoreOrder[]
  mpesaC2bTransactions mpesaC2bTransaction[]
  notifications        notification[]
  branchProductStocks  branchProductStock[]
  zohoPushLogs         zohoPushLog[]
  auditLogs            auditLog[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([county, isActive])
  @@index([zohoOrganizationId])
  @@schema("public")
}

model DeliveryZone {
  id             String   @id @default(uuid())
  county         String
  name           String
  branchId       String?
  branch         branch?  @relation(fields: [branchId], references: [id])
  deliveryFeeKes Int
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([county, isActive])
  @@index([branchId])
  @@schema("public")
}

// Per-branch stock count, synced from that branch's own Zoho POS. The
// product catalog itself (name/price/description/images) stays one shared
// row per SKU in `product` — only quantity is branch-specific. Admin/internal
// use only; the public storefront never reads this (deliberately unlimited
// "in stock" on the customer-facing site — see product.stock's deprecation
// note below).
model branchProductStock {
  id           String    @id @default(cuid())
  branchId     String
  branch       branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  productId    String
  product      product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  stock        Int       @default(0)
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([branchId, productId])
  @@index([productId])
  @@index([branchId, stock])
  @@schema("admin")
}

// One row per real-world Zoho Books organization. Several branches can
// share the same org (credentials + webhook secret live here once, not
// duplicated per branch) — see branch.zohoOrganizationId.
//
// isActive: must be set false (deactivated) before the row can be deleted —
// deactivation itself is blocked while any branch still points at this org
// (branch.zohoOrganizationId), see app/api/admin/zoho/organizations/[id]/route.ts.
model zohoOrganization {
  id               String               @id @default(cuid())
  name             String
  zohoOrgId        String               @unique
  clientIdEnc      String
  clientSecretEnc  String
  refreshTokenEnc  String
  webhookSecretEnc String?
  isActive         Boolean              @default(true)
  connectedAt      DateTime?
  branches         branch[]
  productMappings  productZohoMapping[]
  pushLogs         zohoPushLog[]
  stagedItems      zohoStagedItem[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@schema("admin")
}

// Maps a shared product catalog row to its Zoho item id *within one org's
// catalog*. Necessary because each org assigns its own opaque item ids —
// the same physical product has a different zohoItemId under Org A than
// under Org B. Both directions are direct unique-index lookups.
model productZohoMapping {
  id                  String           @id @default(cuid())
  productId           String
  product             product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  organizationId      String
  organization        zohoOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  zohoItemId          String
  // Zoho Inventory's own item id for the same product (a separate product
  // from Books — its item ids aren't guaranteed to match Books'). Nullable:
  // lib/zoho/push-adjustment.ts reads `zohoInventoryItemId ?? zohoItemId`,
  // so Inventory Adjustments work correctly whether this has been populated
  // yet or the two products' ids happen to be identical.
  zohoInventoryItemId String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([productId, organizationId])
  @@unique([organizationId, zohoItemId])
  @@schema("admin")
}

enum ZohoStagedItemStatus {
  PENDING
  EXCLUDED

  @@schema("admin")
}

// A Zoho item pulled in during sync that has no product mapping yet. Lands
// here instead of auto-creating a live `product` row — an admin reviews it
// and either approves it (creating the product + productZohoMapping) or
// excludes it (status EXCLUDED, so it stops resurfacing in the review queue
// on every sync). rawPayload keeps the full Zoho item response so the review
// UI isn't limited to the flattened fields below.
model zohoStagedItem {
  id                String               @id @default(cuid())
  organizationId    String
  organization      zohoOrganization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  zohoItemId        String
  status            ZohoStagedItemStatus @default(PENDING)
  name              String
  description       String?
  sku               String?
  productType       String?
  zohoStatus        String?
  unit              String?
  brand             String?
  rateKes           Int?
  purchaseRateKes   Int?
  categoryNameRaw   String?
  stockOnHand       Int?
  rawPayload        Json
  firstSeenAt       DateTime             @default(now())
  lastSeenAt        DateTime             @updatedAt
  excludedAt        DateTime?
  excludedByUserId  String?
  reenabledAt       DateTime?
  reenabledByUserId String?

  @@unique([organizationId, zohoItemId])
  @@index([organizationId, status])
  @@schema("admin")
}

enum ZohoPushKind {
  SALES_ORDER
  INVENTORY_ADJUSTMENT
  SALES_RECEIPT

  @@schema("admin")
}

enum ZohoPushStatus {
  SENT
  FAILED
  SKIPPED

  @@schema("admin")
}

// Durable record of every outbound push to Zoho (a sales receipt), written
// once after each attempt completes. Exists so a
// failed push is discoverable in the admin panel instead of only ever
// appearing in server logs — see lib/zoho/push-log.ts.
model zohoPushLog {
  id             String            @id @default(cuid())
  kind           ZohoPushKind
  status         ZohoPushStatus
  organizationId String?
  organization   zohoOrganization? @relation(fields: [organizationId], references: [id])
  branchId       String?
  branch         branch?           @relation(fields: [branchId], references: [id])
  productId      String?
  referenceType  String? // "order" | "inStoreOrder" | "inventoryAdjustment"
  referenceId    String?
  zohoRecordId   String?
  errorMessage   String?
  createdAt      DateTime          @default(now())

  @@index([status, createdAt])
  @@index([referenceType, referenceId])
  @@schema("admin")
}

model transaction {
  id                 String          @id @default(uuid())
  orderId            String
  order              order           @relation(fields: [orderId], references: [id])
  branchId           String?
  branch             branch?         @relation(fields: [branchId], references: [id])
  provider           PaymentProvider
  checkoutRequestId  String?         @unique
  paystackReference  String?         @unique
  amount             Int
  status             TxStatus        @default(PENDING)
  // Which gateway actually handled this M-Pesa payment — null for non-M-Pesa
  // providers. Recorded from the dispatch result, not inferred from
  // branch.mpesaGateway, since a fallback can route a payment through the
  // other gateway than the branch's configured default.
  mpesaGatewayUsed   MpesaGateway?
  rawRequestPayload  Json?
  rawCallbackPayload Json?
  mpesaReceiptNumber String?
  failureReason      String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([orderId])
  @@index([checkoutRequestId])
  @@index([status, createdAt])
  @@schema("public")
}

model contactMessage {
  id        String        @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    ContactStatus @default(new)
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
  @@schema("public")
}

// ============================================================================
// Admin models (admin schema)
// ============================================================================

model adminProfile {
  id                 String            @id @default(uuid())
  userId             String            @unique
  user               user              @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId           String?
  branch             branch?           @relation(fields: [branchId], references: [id])
  fullName           String
  permissions        Json              @default("{}")
  department         String?
  role               String            @default("viewer")
  twoFaMethod        String            @default("totp")
  mutedNotificationTypes NotificationType[] @default([])
  isSuperAdmin       Boolean           @default(false)
  isActive           Boolean           @default(true)
  accessExpiresAt    DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  // Points a super admin may hand out over their lifetime. Deliberately not
  // renewable through any UI or API — only a direct DB UPDATE tops it back up.
  pointsAllowance      Int   @default(100000)
  pointsAllowanceSpent Int   @default(0)
  auditLogs          auditLog[]
  requestedApprovals approvalRequest[] @relation("RequestedApprovals")
  reviewedApprovals  approvalRequest[] @relation("ReviewedApprovals")
  exportRequests     exportRequest[]
  pointsGrantRequests  pointsGrantRequest[]
  pointsGrantApprovals pointsGrantApproval[]

  @@index([branchId])
  @@schema("admin")
}

model auditLog {
  id                String               @id @default(uuid())
  adminProfileId    String
  adminProfile      adminProfile         @relation(fields: [adminProfileId], references: [id])
  action            String
  resource          String
  resourceId        String?
  severity          NotificationSeverity @default(INFO)
  details           Json?
  ipAddress         String?
  userAgent         String?
  path              String?
  // Write-time snapshot of the actor's adminProfile.branchId/isSuperAdmin —
  // not a live join. Preserves "what branch was this admin in when they did
  // this" even if they're reassigned later, and lets the activity-log
  // visibility filter (GET /api/admin/activity) query flat columns instead
  // of joining through adminProfile on every read.
  branchId          String?
  branch            branch?              @relation(fields: [branchId], references: [id])
  actorIsSuperAdmin Boolean              @default(false)
  createdAt         DateTime             @default(now())

  @@index([adminProfileId, createdAt])
  @@index([branchId, createdAt])
  @@index([severity, createdAt])
  @@schema("admin")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("admin")
}

// A sensitive action a non-admin/super_admin role attempted — queued instead
// of executed until an admin/super_admin reviews it. See
// lib/require-approval.ts for the gate that creates these, and
// app/api/admin/approvals/[id]/decide/route.ts for what happens on approval
// (the original action is re-run from `payload`).
model approvalRequest {
  id                        String         @id @default(uuid())
  requestedByAdminProfileId String
  requestedBy               adminProfile   @relation("RequestedApprovals", fields: [requestedByAdminProfileId], references: [id])
  resource                  String
  action                    String
  resourceId                String?
  payload                   Json
  status                    ApprovalStatus @default(PENDING)
  reviewedByAdminProfileId  String?
  reviewedBy                adminProfile?  @relation("ReviewedApprovals", fields: [reviewedByAdminProfileId], references: [id])
  reviewNote                String?
  reviewedAt                DateTime?
  createdAt                 DateTime       @default(now())
  exportRequest             exportRequest?

  @@index([status, createdAt])
  @@index([requestedByAdminProfileId])
  @@schema("admin")
}

enum ExportRequestStatus {
  PENDING
  GENERATING
  READY
  FAILED

  @@schema("admin")
}

// A generated report file (Orders/Finance export). Kept separate from
// approvalRequest because the admin/super_admin fast path never creates an
// approval row at all — file-result state (fileKey, status, deliveredAt)
// needs a home that doesn't depend on one existing. See
// lib/reports/generate-export.ts for what fills these fields in, and
// app/api/admin/exports/[id]/download/route.ts for the ownership-gated
// streaming download that reads fileKey back out of R2.
model exportRequest {
  id                        String               @id @default(uuid())
  requestedByAdminProfileId String
  requestedBy               adminProfile         @relation(fields: [requestedByAdminProfileId], references: [id])
  resource                  String // "orders" | "finance"
  format                    String // "pdf" | "csv" | "xml"
  filters                   Json
  status                    ExportRequestStatus  @default(PENDING)
  approvalRequestId         String?              @unique
  approvalRequest           approvalRequest?     @relation(fields: [approvalRequestId], references: [id])
  fileKey                   String?
  fileName                  String?
  fileSizeBytes             Int?
  errorMessage              String?
  deliveredAt               DateTime?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  @@index([requestedByAdminProfileId, status, createdAt])
  @@schema("admin")
}

model systemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@schema("admin")
}

model notification {
  id          String               @id @default(cuid())
  type        NotificationType
  severity    NotificationSeverity
  title       String
  body        String
  link        String?
  branchId    String?
  branch      branch?              @relation(fields: [branchId], references: [id])
  targetRoles String[]             @default([])
  read        Boolean              @default(false)
  createdAt   DateTime             @default(now())

  recipientStates notificationRecipientState[]

  @@index([read, createdAt])
  @@index([branchId, createdAt])
  @@index([severity, createdAt])
  @@schema("admin")
}

model notificationRecipientState {
  id             String       @id @default(cuid())
  notificationId String
  notification   notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  readAt         DateTime?
  pinned         Boolean      @default(false)
  dismissed      Boolean      @default(false)

  @@unique([notificationId, userId])
  @@index([userId, readAt])
  @@schema("admin")
}

// ============================================================================
// Client models (client schema)
// ============================================================================

model clientProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone       String?
  country     String?
  city        String?
  companyId   String?  @unique
  companyName String?
  loginCount  Int      @default(0)
  source      String? // null for normal signups, "IN_STORE" for walk-ins created via admin in-store order flow
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@schema("client")
}

// ============================================================================
// Support Tickets (public schema)
// ============================================================================

model supportTicket {
  id              String          @id @default(cuid())
  ticketNumber    String          @unique
  userId          String
  user            user            @relation("TicketOwner", fields: [userId], references: [id])
  assignedAdminId String?
  // SetNull — deleting a staff member unassigns their tickets instead of
  // being blocked by the FK; the ticket itself (id, history, owner) is
  // untouched, it just goes back to unassigned.
  assignedAdmin   user?           @relation("TicketAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  subject         String
  status          TicketStatus    @default(OPEN)
  lastActivityAt  DateTime        @default(now())
  expiresAt       DateTime
  messages        ticketMessage[]
  createdAt       DateTime        @default(now())

  @@index([status, lastActivityAt])
  @@index([assignedAdminId, status])
  @@schema("public")
}

model ticketMessage {
  id             String        @id @default(cuid())
  ticketId       String
  ticket         supportTicket @relation(fields: [ticketId], references: [id])
  senderType     MessageSender
  content        String        @db.Text
  attachmentUrl  String?
  attachmentName String?
  attachmentType String?
  attachmentSize Int?
  emailSentAt    DateTime?
  createdAt      DateTime      @default(now())

  @@index([ticketId])
  @@schema("public")
}

// ============================================================================
// Loyalty — points, badges, referrals (public schema)
// ============================================================================

enum PointsReason {
  SIGNUP_BONUS
  REFERRAL_REWARD
  REFERRED_BONUS
  ORDER_BASE
  ORDER_VALUE_TIER
  STREAK_4W
  STREAK_6M_WEEKLY
  STREAK_6M_MONTHLY
  BADGE_AWARD
  SUPER_ADMIN_GRANT
  COUPON_BONUS
  REDEEM
  REDEEM_REVERSED
  ORDER_REFUND_CLAWBACK
  BONUS_VOIDED_ABUSE

  @@schema("public")
}

enum IdentityKind {
  IP
  DEVICE
  PAY_MPESA
  PAY_CARD
  PHONE
  EMAIL_NORM

  @@schema("public")
}

enum BadgeRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
  MYTHIC

  @@schema("admin")
}

enum BadgeGrantType {
  AUTO
  MANUAL

  @@schema("admin")
}

/// Read cache over pointsLedger. `points` / `lockedPoints` are denormalized
/// sums — the ledger chain is the source of truth, and this row is also the
/// per-user lock (SELECT ... FOR UPDATE) that serializes ledger appends.
/// `tier` is retained only so the column drop never has to run; nothing reads
/// it any more — level is derived from badgeCount. See lib/points/ledger.ts.
model loyaltyPoints {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              user     @relation(fields: [userId], references: [id])
  points            Int      @default(0)
  lockedPoints      Int      @default(0)
  lifetimeEarned    Int      @default(0)
  lifetimeRedeemed  Int      @default(0)
  level             Int      @default(1)
  badgeCount        Int      @default(0)
  userCode          String   @unique
  referralCode      String   @unique
  leaderboardPublic Boolean  @default(false)
  tier              String   @default("BRONZE")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([points])
  @@schema("public")
}

/// Append-only, HMAC hash-chained. Never UPDATE or DELETE a row — corrections
/// are compensating entries. Enforced at the database by the trigger in
/// prisma/sql/points-ledger-guard.sql.
model pointsLedger {
  id           String       @id @default(uuid())
  userId       String
  seq          Int
  // delta moves spendable balance, lockedDelta moves the locked pot. Every
  // case is one entry: earn (+d, 0), lock (0, +d), unlock (+d, -d),
  // void (0, -d), redeem (-d, 0).
  delta        Int
  lockedDelta  Int          @default(0)
  balanceAfter Int
  lockedAfter  Int
  reason       PointsReason
  refType      String?
  refId        String?
  meta         Json?
  prevHash     String
  hash         String
  createdAt    DateTime     @default(now())
  user         user         @relation(fields: [userId], references: [id])

  @@unique([userId, seq])
  // Idempotency: a replayed payment callback violates this and no-ops.
  @@unique([userId, reason, refType, refId])
  @@index([userId, createdAt])
  @@index([reason])
  @@schema("public")
}

model userBadge {
  id                      String   @id @default(uuid())
  userId                  String
  badgeId                 String
  earnedAt                DateTime @default(now())
  grantedByAdminProfileId String?
  user                    user     @relation(fields: [userId], references: [id])

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
  @@schema("public")
}

model referral {
  id             String    @id @default(uuid())
  referrerUserId String
  referredUserId String    @unique
  code           String
  convertedAt    DateTime?
  rewardedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([referrerUserId])
  @@index([code])
  @@schema("public")
}

/// One row per (user, signal). Values are HMAC-hashed, never stored raw.
/// The [kind, valueHash] index is the collision lookup that powers risk scoring.
model identitySignal {
  id          String       @id @default(uuid())
  userId      String
  kind        IdentityKind
  valueHash   String
  firstSeenAt DateTime     @default(now())
  lastSeenAt  DateTime     @updatedAt

  @@unique([userId, kind, valueHash])
  @@index([kind, valueHash])
  @@index([userId])
  @@schema("public")
}

model couponRedemption {
  id         String   @id @default(uuid())
  couponId   String
  userId     String
  orderId    String   @unique
  redeemedAt DateTime @default(now())

  // Not unique on [couponId, userId] anymore — promotion.maxUsesPerUser lets a
  // user redeem the same coupon more than once; resolvePromo() in lib/promo.ts
  // enforces the configured limit by counting rows here instead.
  @@index([couponId, userId])
  @@index([couponId])
  @@index([userId])
  @@schema("public")
}

// ============================================================================
// Marketing (admin schema)
// ============================================================================

model campaign {
  id                  String         @id @default(cuid())
  name                String
  type                CampaignType
  audienceType        String         @default("ALL")
  subject             String?
  heading             String?
  previewText         String?
  content             String?        @db.Text
  audienceCustomerIds String[]       @default([])
  status              CampaignStatus @default(DRAFT)
  scheduledAt         DateTime?
  sentAt              DateTime?
  sentCount           Int            @default(0)
  lastError           String?        @db.Text
  createdAt           DateTime       @default(now())

  @@schema("admin")
}

enum CampaignChannel {
  EMAIL
  SMS
  PUSH

  @@schema("admin")
}

enum RecipientStatus {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  SPAM
  FAILED
  OPENED
  CLICKED

  @@schema("admin")
}

model campaignRecipient {
  id                String          @id @default(cuid())
  campaignId        String
  userId            String
  channel           CampaignChannel
  status            RecipientStatus @default(QUEUED)
  providerMessageId String?
  errorMessage      String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  openedAt          DateTime?
  clickedAt         DateTime?
  failedAt          DateTime?
  createdAt         DateTime        @default(now())

  @@unique([campaignId, userId, channel])
  @@index([providerMessageId])
  @@schema("admin")
}

model promotion {
  id             String    @id @default(cuid())
  name           String
  type           String
  value          Float
  code           String?   @unique
  minOrder       Int?
  maxUses        Int?
  // How many times a single user may reuse this coupon. 0 = unlimited, 1 = default (one use per user).
  maxUsesPerUser Int       @default(1)
  usedCount      Int       @default(0)
  startDate      DateTime?
  endDate        DateTime?
  status         String    @default("active")
  // Caps the absolute discount a PERCENTAGE or FIXED coupon may produce, in
  // cents. Null = uncapped. Used by the auto-issued VIP coupons.
  maxDiscountKes Int?
  // Null = a store coupon, created by staff. Set = a customer coupon: that
  // customer's personal referral code, created automatically alongside their
  // loyalty account. This one column is the Store/Customer tab discriminator
  // and the link that lets payment success credit the right referrer.
  ownerUserId    String?
  // Loyalty points the coupon grants the customer who redeems it, credited at
  // payment success. Capped at 3000 and gated by the approval queue.
  pointsAward    Int       @default(0)
  // Only PENDING blocks redemption. Defaults to APPROVED so every pre-existing
  // coupon keeps working untouched.
  approvalStatus ApprovalStatus @default(APPROVED)
  // Soft delete. The row and its redemption history survive so the audit trail
  // stays intact — couponRedemption has no FK to cascade from anyway.
  disabledAt     DateTime?
  disabledByAdminProfileId String?
  createdAt      DateTime  @default(now())

  @@index([ownerUserId])
  @@index([approvalStatus])
  @@schema("admin")
}

// ============================================================================
// Content (admin schema)
// ============================================================================

model blogPost {
  id            String     @id @default(cuid())
  title         String
  slug          String     @unique
  excerpt       String?
  content       String?    @db.Text
  featuredImage String?
  category      String?
  tags          String[]
  status        PostStatus @default(DRAFT)
  authorId      String?
  // SetNull — deleting a staff member unattributes their posts instead of
  // being blocked by the FK (same reasoning as supportTicket.assignedAdmin).
  // Every read site already treats `author` as nullable (`post.author?.name
  // ?? "Fechi Organics"`), so this doesn't change any consuming code.
  author        user?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorIds     String[]   @default([])
  publishedAt   DateTime?
  seoTitle      String?
  metaDesc      String?
  views         Int        @default(0)
  createdAt     DateTime   @default(now())

  likeCount    Int     @default(0)
  dislikeCount Int     @default(0)
  commentCount Int     @default(0)
  isFeatured   Boolean @default(false)

  viewEvents blogView[]
  reactions  blogReaction[]
  comments   blogComment[]

  @@schema("admin")
}

model blogView {
  id         String   @id @default(cuid())
  postId     String
  post       blogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId     String?
  viewerHash String?
  viewedAt   DateTime @default(now())

  @@index([postId, viewedAt])
  @@schema("admin")
}

model blogReaction {
  id        String       @id @default(cuid())
  postId    String
  post      blogPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      user         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ReactionType
  createdAt DateTime     @default(now())

  @@unique([postId, userId])
  @@schema("admin")
}

enum ReactionType {
  LIKE
  DISLIKE

  @@schema("admin")
}

model blogComment {
  id        String        @id @default(cuid())
  postId    String
  post      blogPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      user          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId  String?
  content   String
  status    CommentStatus @default(VISIBLE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([postId, status])
  @@schema("admin")
}

enum CommentStatus {
  VISIBLE
  HIDDEN
  FLAGGED

  @@schema("admin")
}

model homepageSection {
  id      String  @id @default(cuid())
  type    String
  order   Int
  visible Boolean @default(true)
  config  Json

  @@schema("admin")
}

model banner {
  id        String    @id @default(cuid())
  name      String
  location  String
  imageKey  String
  ctaText   String?
  ctaLink   String?
  startDate DateTime?
  endDate   DateTime?
  status    String    @default("active")

  @@schema("admin")
}

model faq {
  id       String @id @default(cuid())
  question String
  answer   String @db.Text
  group    String @default("General")
  order    Int    @default(0)
  status   String @default("published")

  @@schema("admin")
}

// ============================================================================
// Suppliers + Purchase Orders (admin schema)
// ============================================================================

model supplier {
  id             String          @id @default(cuid())
  name           String
  contactPerson  String?
  email          String?
  phone          String?
  address        String?
  categories     String[]
  paymentTerms   String?
  notes          String?
  status         String          @default("active")
  purchaseOrders purchaseOrder[]
  createdAt      DateTime        @default(now())

  @@schema("admin")
}

model purchaseOrder {
